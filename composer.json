{
    "name": "sifrious/menard",
    "description": "Retrieval preparation: citable passages, replaceable indexes, and token-budgeted context packs.",
    "keywords": [
        "laravel",
        "retrieval",
        "chunking",
        "reranking",
        "context"
    ],
    "homepage": "https://github.com/sifrious/menard",
    "license": "MIT",
    "authors": [
        {
            "name": "sifrious",
            "email": "mmebit@icloud.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Menard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Menard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\Menard\\MenardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
